{
  "name": "frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:host": "vite dev --port 3000 --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint --fix . && eslint --fix .",
    "lint:markup": "markuplint \"src/**/*.tsx\" --fix --problem-only",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/helpers": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@fontsource/klee-one": "^5.3.1",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/router-plugin": "1.168.47",
    "jotai": "^3.0.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.14.8",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@markuplint/jsx-parser": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "1.167.45",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "markuplint": "^5.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss-custom-media": "^12.0.3",
    "react-scan": "^0.5.7",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
