{
  "name": "frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:host": "vite dev --port 3000 --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint --fix . && eslint --fix .",
    "lint:markup": "markuplint \"src/**/*.tsx\" --fix --problem-only",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource/klee-one": "^5.3.0",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/router-plugin": "1.168.35",
    "jotai": "^2.20.3",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@markuplint/jsx-parser": "^4.18.3",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "1.167.33",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "markuplint": "^4.18.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "react-scan": "^0.5.7",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
